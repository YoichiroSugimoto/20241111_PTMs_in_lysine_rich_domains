## All hidden files except .gitignore, the sentinel, and the renv .Rprofile
.*
!/.gitignore
!/.here
!/.Rprofile

## cluster runnning log won't be included
## slurm-*

## Microsoft files
*.docx
*.xlsx
*.pptx
*.doc
*.xls
*.ppt

## ignore rawdata directory
## http://stackoverflow.com/questions/1470572/gitignore-ignore-any-bin-directory
rawdata/
Rawdata/
annotation/
results/
## ignore sofrware directory
software/
temp/
R/renv/

## ignore md and figure documents in R
## R/**/*_files
! R/**/*.md


## ignore figure documents in doc
## doc/**/*_files

## ignore raw data
*.fastq
*.fq
*.fasta
*.fa
*.gff3
*.gtf
*.bam
*.bai
*.bed
*.tab
*.tsv
*.gz

## ignore temp data
*.tmp

## Figures
*.pdf
*.ai
*.eps
*.jpeg
*.tif

## Compiled files
*.html

## Core latex/pdflatex auxiliary files:
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.backup

## Bibliography auxiliary files (bibtex/biblatex/biber):
*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.brf
*.run.xml

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite
*~
\#*\#

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# R
.Rhistory

# Emacs
.#*

# renv — ignore the large, machine-specific library and build caches.
# Keep renv/activate.R, renv/settings.json and the lockfile (R/renv.lock) tracked.
# The renv project lives at the repo root here (renv/), not under R/.
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
# (also cover an R/renv/ layout, just in case)
R/renv/library/
R/renv/staging/
R/renv/
.Rproj.user

## ----------------------------------------------------------------------------
## data/ : commit the small inputs, ignore the large downloads.
## git cannot filter by size, so large files are matched by name/type below.
## Add a pattern here if you introduce another large input.
## ----------------------------------------------------------------------------
## Large MaxQuant / FragPipe / derived files — fetch from PRIDE / UniProt:
data/**/*_evidence.txt
data/**/*proteinGroups.txt
data/**/all_protein_feature_per_position.csv
data/**/long_K_stoichiometry_data.csv
## (psm.tsv and *.diagnosticIons.tsv are already ignored by the *.tsv rule above)

## Re-include the small data files that the global rules above would hide:
!data/**/*.xlsx
!data/**/.gitkeep
